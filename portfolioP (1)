<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#050509;
    color:#f4f4f7;
    font-family:Inter,sans-serif;
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button{
    font-family:inherit;
}

::selection{
    background:#9275ff;
    color:white;
}

body::before{
    content:"";
    position:fixed;
    inset:-30%;
    z-index:-5;
    background:
    radial-gradient(circle at 15% 20%,rgba(126,91,255,.22),transparent 25%),
    radial-gradient(circle at 85% 15%,rgba(44,205,255,.15),transparent 24%),
    radial-gradient(circle at 70% 80%,rgba(255,72,188,.13),transparent 25%);
    filter:blur(50px);
    animation:backgroundMove 15s ease-in-out infinite alternate;
}

body::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-4;
    pointer-events:none;
    background-image:
    linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
    background-size:70px 70px;
}

@keyframes backgroundMove{
    to{
        transform:translate(4%,3%) scale(1.08);
    }
}

#stars{
    position:fixed;
    inset:0;
    z-index:-3;
    pointer-events:none;
}


/* CURSOR */

.cursor{
    position:fixed;
    width:10px;
    height:10px;
    background:white;
    border-radius:50%;
    pointer-events:none;
    z-index:9999;
    transform:translate(-50%,-50%);
    box-shadow:0 0 12px #5de7ff,0 0 25px #8c6cff;
    transition:width .2s,height .2s;
}

.cursor::after{
    content:"";
    position:absolute;
    width:34px;
    height:34px;
    border:1px solid rgba(93,231,255,.6);
    border-radius:50%;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    transition:.25s;
}

.cursor.hover{
    width:6px;
    height:6px;
}

.cursor.hover::after{
    width:52px;
    height:52px;
    border-color:#ff6fc9;
}


/* PROGRESS */

.progress{
    position:fixed;
    top:0;
    left:0;
    width:0;
    height:2px;
    z-index:999;
    background:linear-gradient(90deg,#8c6cff,#5de7ff,#ff6fc9);
}


/* COMMON */

.container{
    width:min(1160px,calc(100% - 40px));
    margin:auto;
}

.section{
    padding:120px 0;
}

.label{
    font:10px "DM Mono",monospace;
    letter-spacing:3px;
    color:#888b98;
    text-transform:uppercase;
}

.title{
    font:700 clamp(45px,6vw,78px) "Space Grotesk",sans-serif;
    line-height:.95;
    letter-spacing:-4px;
    margin-top:14px;
}

.gradient{
    background:linear-gradient(100deg,#fff,#a99aff,#5de7ff,#ff72c9);
    background-size:220% auto;
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    animation:gradientMove 7s linear infinite;
}

@keyframes gradientMove{
    to{
        background-position:220% center;
    }
}

.text{
    color:#999ba7;
    font-size:14px;
    line-height:1.9;
}


/* NAV */

.nav{
    position:fixed;
    top:16px;
    left:50%;
    transform:translateX(-50%);
    width:min(1130px,calc(100% - 30px));
    height:62px;
    padding:0 18px;
    border:1px solid rgba(255,255,255,.09);
    background:rgba(5,5,9,.72);
    backdrop-filter:blur(22px);
    border-radius:18px;
    z-index:100;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font:700 19px "Space Grotesk",sans-serif;
    letter-spacing:-1px;
}

.logo span{
    color:#5de7ff;
}

.navlinks{
    display:flex;
    gap:25px;
}

.navlinks a{
    font:10px "DM Mono",monospace;
    color:#858793;
    transition:.25s;
}

.navlinks a:hover{
    color:white;
}

.navmail{
    font:700 9px "DM Mono",monospace;
    padding:10px 14px;
    border:1px solid rgba(255,255,255,.1);
    border-radius:10px;
}

.menu{
    display:none;
    background:transparent;
    color:white;
    border:1px solid rgba(255,255,255,.15);
    padding:8px 11px;
    border-radius:9px;
}


/* HERO */

.hero{
    min-height:100vh;
    padding-top:145px;
    display:flex;
    align-items:center;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:60px;
    align-items:center;
}

.status{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:7px 11px;
    border:1px solid rgba(255,255,255,.1);
    background:rgba(255,255,255,.03);
    border-radius:30px;
    font:9px "DM Mono",monospace;
    color:#bbb;
}

.dot{
    width:6px;
    height:6px;
    border-radius:50%;
    background:#68e89a;
    box-shadow:0 0 14px #68e89a;
}

.hero h1{
    font:700 clamp(68px,9vw,125px) "Space Grotesk",sans-serif;
    line-height:.82;
    letter-spacing:-8px;
    margin:30px 0;
}

.hero .text{
    max-width:650px;
    font-size:15px;
}

.buttons{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:28px;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:13px 17px;
    border-radius:11px;
    border:1px solid rgba(255,255,255,.12);
    font-size:10px;
    font-weight:800;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-3px);
    border-color:#5de7ff;
}

.btn.main{
    border:none;
    background:linear-gradient(100deg,#8368ff,#5c9dff);
}


/* PHOTO */

.hero-photo{
    height:570px;
    position:relative;
}

.photo{
    position:absolute;
    inset:20px 20px 0 45px;
    border-radius:32px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.14);
    background:#111;
    transform:rotate(2deg);
    box-shadow:0 35px 100px rgba(0,0,0,.55);
}

.photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top;
}

.photo::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 55%,rgba(0,0,0,.65));
}

.float{
    position:absolute;
    z-index:2;
    padding:12px 14px;
    border-radius:13px;
    background:rgba(5,5,10,.8);
    backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,.1);
    font:9px "DM Mono",monospace;
}

.f1{
    top:65px;
    left:0;
    color:#5de7ff;
}

.f2{
    right:0;
    bottom:65px;
    color:#b9aaff;
}

.f3{
    top:15px;
    right:20px;
    width:65px;
    height:65px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:#ff75ca;
}


/* ABOUT */

.about-top{
    display:flex;
    justify-content:space-between;
    gap:50px;
    align-items:end;
    margin-bottom:40px;
}

.about-top .text{
    max-width:600px;
}

.cards{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:14px;
}

.card{
    position:relative;
    padding:30px;
    border-radius:23px;
    border:1px solid rgba(255,255,255,.08);
    background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.015));
    overflow:hidden;
    transition:.3s;
}

.card:hover{
    border-color:rgba(140,108,255,.3);
    transform:translateY(-4px);
}

.quote{
    font:500 clamp(28px,3vw,42px) "Space Grotesk",sans-serif;
    line-height:1.15;
    letter-spacing:-2px;
}

.quote span{
    color:#5de7ff;
}

.stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:30px;
}

.stat{
    padding:17px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:14px;
}

.stat strong{
    font:700 31px "Space Grotesk",sans-serif;
    display:block;
}

.stat small{
    font:9px "DM Mono",monospace;
    color:#777985;
    text-transform:uppercase;
}

.card h3{
    font:600 25px "Space Grotesk",sans-serif;
    margin:10px 0;
}


/* SKILLS */

.skills-head{
    margin-bottom:40px;
}

.skills{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.skill{
    min-height:200px;
}

.num{
    font:32px "Space Grotesk",sans-serif;
    color:#a99aff;
}

.chips{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin-top:18px;
}

.chip{
    padding:7px 9px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:8px;
    color:#bbbcc5;
    font-size:9px;
    background:rgba(255,255,255,.025);
}


/* PROJECTS */

.projects-head{
    display:flex;
    justify-content:space-between;
    gap:40px;
    align-items:end;
    margin-bottom:40px;
}

.projects-head .text{
    max-width:560px;
}

.projects{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.project{
    min-height:360px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
}

.project-num{
    font:9px "DM Mono",monospace;
    color:#5de7ff;
}

.project h3{
    font:600 35px "Space Grotesk",sans-serif;
    line-height:1;
    margin:15px 0;
}

.project-link{
    font:800 9px "DM Mono",monospace;
    color:#b6aaff;
}


/* TERMINAL */

.terminal{
    margin-top:15px;
    background:#08090d;
    border:1px solid rgba(255,255,255,.09);
    border-radius:20px;
    overflow:hidden;
}

.term-head{
    height:42px;
    border-bottom:1px solid rgba(255,255,255,.07);
    display:flex;
    gap:6px;
    align-items:center;
    padding:0 15px;
}

.term-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#33353e;
}

.term-body{
    padding:25px;
    font:11px/2 "DM Mono",monospace;
}

.cyan{
    color:#5de7ff;
}

.purple{
    color:#a99aff;
}

.green{
    color:#72e5a0;
}

.pink{
    color:#ff73c8;
}


/* JOURNEY */

.journey{
    display:grid;
    grid-template-columns:.75fr 1.25fr;
    gap:14px;
}

.edu{
    min-height:310px;
}

.edu h3{
    font-size:35px;
    margin-top:15px;
}

.timeline{
    border-left:1px solid rgba(255,255,255,.12);
    padding-left:28px;
}

.item{
    position:relative;
    padding-bottom:35px;
}

.item:last-child{
    padding-bottom:0;
}

.item::before{
    content:"";
    position:absolute;
    width:8px;
    height:8px;
    border-radius:50%;
    background:#8c6cff;
    left:-33px;
    top:6px;
    box-shadow:0 0 16px #8c6cff;
}

.item small{
    font:9px "DM Mono",monospace;
    color:#5de7ff;
}

.item h3{
    font-size:21px;
    margin:5px 0;
}


/* FUTURE */

.next{
    min-height:330px;
}

.next .title{
    max-width:700px;
}

.next .text{
    max-width:670px;
    margin-top:25px;
}

.bigword{
    position:absolute;
    right:20px;
    bottom:-15px;
    font:700 100px "Space Grotesk",sans-serif;
    color:rgba(255,255,255,.035);
}


/* CONTACT */

.contact{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:14px;
}

.contact-title{
    font:700 clamp(50px,6vw,80px) "Space Grotesk",sans-serif;
    line-height:.9;
    letter-spacing:-5px;
    margin:25px 0;
}

.contact-links{
    display:grid;
    gap:10px;
}

.contact-links a{
    padding:20px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:14px;
    background:rgba(255,255,255,.025);
    font-size:11px;
    transition:.25s;
}

.contact-links a:hover{
    transform:translateX(5px);
    border-color:#5de7ff;
}


/* FOOTER */

footer{
    border-top:1px solid rgba(255,255,255,.08);
    padding:28px 0;
    color:#696b76;
    font:9px "DM Mono",monospace;
}

.footer{
    display:flex;
    justify-content:space-between;
}


/* ANIMATION */

.reveal{
    opacity:0;
    transform:translateY(25px);
    transition:.8s;
}

.reveal.show{
    opacity:1;
    transform:translateY(0);
}


/* TABLET */

@media(max-width:900px){

    .navlinks,
    .navmail{
        display:none;
    }

    .menu{
        display:block;
    }

    .hero-grid,
    .cards,
    .journey,
    .contact{
        grid-template-columns:1fr;
    }

    .skills{
        grid-template-columns:1fr 1fr;
    }

    .hero-photo{
        height:500px;
    }

    .about-top,
    .projects-head{
        display:block;
    }

    .about-top .text,
    .projects-head .text{
        margin-top:20px;
    }
}


/* MOBILE */

@media(max-width:600px){

    body{
        cursor:auto;
    }

    .cursor{
        display:none;
    }

    .container{
        width:calc(100% - 28px);
    }

    .section{
        padding:90px 0;
    }

    .hero{
        padding-top:120px;
    }

    .hero h1{
        font-size:67px;
        letter-spacing:-5px;
    }

    .hero-photo{
        height:420px;
    }

    .photo{
        inset:15px 12px 0;
    }

    .skills,
    .projects{
        grid-template-columns:1fr;
    }

    .title{
        font-size:50px;
        letter-spacing:-3px;
    }

    .project{
        min-height:310px;
    }

    .card{
        padding:23px;
    }

    .footer{
        display:block;
    }

    .footer div+div{
        margin-top:8px;
    }
}

/* Custom cursor - neon ring + center dot */
.cursor {
    position: fixed;
    width: 24px;
    height: 24px;
    border: 2px solid #a855f7;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width .18s ease, height .18s ease, border-color .18s ease,
                background .18s ease, transform .08s linear;
    mix-blend-mode: screen;
}

.cursor::after {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 12px #38bdf8, 0 0 24px #a855f7;
    transform: translate(-50%, -50%);
}

.cursor.hover {
    width: 42px;
    height: 42px;
    border-color: #38bdf8;
    background: rgba(168, 85, 247, .10);
}

.cursor.hover::after {
    width: 7px;
    height: 7px;
}

@media (pointer: coarse) {
    .cursor {
        display: none;
    }
}

</style>
</head>

